<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GrowTech.GT | Websites. Technology. Growth.</title>

    <meta name="description" content="GrowTech.GT helps businesses grow through modern website design, digital solutions and smarter business systems.">
    <meta name="theme-color" content="#090d0b">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* =========================================
           GROWTECH.GT — MAIN WEBSITE STYLES
        ========================================== */

        :root {
            --background: #090d0b;
            --surface: #111814;
            --surface-light: #17211b;
            --primary: #b7f56a;
            --primary-hover: #caff8b;
            --text: #f4f7f2;
            --muted: #98a49b;
            --border: rgba(255,255,255,0.09);
            --font-heading: 'Space Grotesk', sans-serif;
            --font-body: 'DM Sans', sans-serif;
            --container: 1180px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        body {
            background: var(--background);
            color: var(--text);
            font-family: var(--font-body);
            overflow-x: hidden;
            line-height: 1.6;
        }

        body.menu-open {
            overflow: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .container {
            width: min(var(--container), calc(100% - 48px));
            margin: 0 auto;
        }

        .section {
            padding: 110px 0;
        }

        .section-label {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 22px;
        }

        .section-label::before {
            content: "";
            width: 24px;
            height: 1px;
            background: var(--primary);
        }

        .section-heading {
            font-family: var(--font-heading);
            font-size: clamp(34px, 4.5vw, 54px);
            line-height: 1.12;
            letter-spacing: -2px;
            max-width: 720px;
        }

        .section-heading span {
            color: var(--primary);
        }

        .section-description {
            color: var(--muted);
            font-size: 16px;
            max-width: 560px;
            margin-top: 20px;
            line-height: 1.8;
        }

        .primary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            background: var(--primary);
            color: #10180c;
            padding: 15px 23px;
            border-radius: 7px;
            font-size: 14px;
            font-weight: 800;
            transition: .3s ease;
            border: 1px solid var(--primary);
        }

        .primary-btn:hover {
            background: var(--primary-hover);
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(183,245,106,.15);
        }

        .primary-btn svg,
        .text-link svg {
            width: 17px;
            height: 17px;
            transition: transform .3s ease;
        }

        .primary-btn:hover svg {
            transform: translateX(4px);
        }

        .secondary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 15px 23px;
            border-radius: 7px;
            border: 1px solid var(--border);
            color: var(--text);
            font-size: 14px;
            font-weight: 700;
            transition: .3s ease;
        }

        .secondary-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: translateY(-3px);
        }

        /* =========================================
           NAVIGATION
        ========================================== */

        .navbar {
            position: fixed;
            z-index: 1000;
            top: 0;
            left: 0;
            width: 100%;
            border-bottom: 1px solid transparent;
            transition: .3s ease;
        }

        .navbar.scrolled {
            background: rgba(9,13,11,.94);
            border-bottom-color: var(--border);
            backdrop-filter: blur(18px);
        }

        .nav-content {
            height: 84px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            font-family: var(--font-heading);
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: var(--primary);
            color: #0b1209;
            border-radius: 9px;
            display: grid;
            place-items: center;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .logo .dot {
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 35px;
            list-style: none;
        }

        .nav-links a {
            font-size: 13px;
            color: #bac3bc;
            transition: .3s ease;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .nav-cta {
            padding: 11px 17px;
            font-size: 12px;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            color: white;
            font-size: 27px;
        }

        /* =========================================
           HERO SECTION
        ========================================== */

        .hero {
            min-height: 760px;
            padding: 180px 0 110px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(137,207,73,.13), transparent 70%);
            top: 5%;
            right: -5%;
            pointer-events: none;
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 1px;
            height: 100%;
            left: 50%;
            top: 0;
            background: linear-gradient(transparent, rgba(255,255,255,.025), transparent);
            pointer-events: none;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            align-items: center;
            gap: 55px;
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 1px solid rgba(183,245,106,.2);
            background: rgba(183,245,106,.06);
            padding: 8px 13px;
            border-radius: 50px;
            font-size: 11px;
            color: #c9e7ad;
            margin-bottom: 27px;
            letter-spacing: .4px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background: var(--primary);
            border-radius: 50%;
            box-shadow: 0 0 12px var(--primary);
        }

        .hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(47px, 6vw, 78px);
            line-height: 1.02;
            letter-spacing: -4px;
            font-weight: 700;
            max-width: 650px;
        }

        .hero h1 span {
            color: var(--primary);
        }

        .hero-description {
            color: var(--muted);
            font-size: 16px;
            line-height: 1.9;
            max-width: 510px;
            margin: 27px 0 34px;
        }

        .hero-buttons {
            display: flex;
            gap: 13px;
            flex-wrap: wrap;
        }

        .hero-trust {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-top: 44px;
            color: var(--muted);
            font-size: 12px;
        }

        .trust-line {
            width: 35px;
            height: 1px;
            background: var(--primary);
        }

        /* Hero visual */

        .hero-visual {
            position: relative;
            min-height: 450px;
            display: grid;
            place-items: center;
        }

        .visual-glow {
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: rgba(158,233,92,.10);
            filter: blur(70px);
        }

        .dashboard {
            width: 100%;
            max-width: 490px;
            background: #111914;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 15px;
            padding: 21px;
            position: relative;
            z-index: 2;
            box-shadow: 0 35px 100px rgba(0,0,0,.4);
            transform: rotate(-2deg);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(-2deg); }
            50% { transform: translateY(-12px) rotate(-1deg); }
        }

        .dashboard-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
            padding-bottom: 17px;
            margin-bottom: 23px;
        }

        .dashboard-brand {
            font-family: var(--font-heading);
            font-weight: 700;
            font-size: 15px;
        }

        .dashboard-brand span {
            color: var(--primary);
        }

        .dashboard-dots {
            display: flex;
            gap: 5px;
        }

        .dashboard-dots i {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #435047;
        }

        .dashboard-dots i:first-child {
            background: var(--primary);
        }

        .dashboard-welcome {
            color: var(--muted);
            font-size: 11px;
            margin-bottom: 6px;
        }

        .dashboard-title {
            font-family: var(--font-heading);
            font-size: 23px;
            margin-bottom: 22px;
        }

        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 17px;
        }

        .mini-card {
            background: #1a251e;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 13px 10px;
        }

        .mini-card small {
            color: var(--muted);
            font-size: 9px;
        }

        .mini-card strong {
            display: block;
            font-family: var(--font-heading);
            font-size: 19px;
            margin-top: 6px;
        }

        .mini-card .positive {
            font-size: 9px;
            color: var(--primary);
            margin-top: 4px;
        }

        .dashboard-chart {
            border: 1px solid var(--border);
            background: #162019;
            border-radius: 9px;
            padding: 17px;
        }

        .chart-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 23px;
            font-size: 11px;
        }

        .chart-heading span:last-child {
            color: var(--primary);
        }

        .chart-bars {
            height: 110px;
            display: flex;
            align-items: end;
            gap: 10px;
        }

        .chart-bar {
            flex: 1;
            border-radius: 4px 4px 0 0;
            background: linear-gradient(180deg, #b7f56a, #4f8030);
            opacity: .85;
            transition: .4s ease;
        }

        .chart-bar:hover {
            opacity: 1;
            filter: brightness(1.3);
        }

        .floating-card {
            position: absolute;
            z-index: 3;
            background: #19241d;
            border: 1px solid rgba(183,245,106,.25);
            border-radius: 10px;
            padding: 13px 16px;
            box-shadow: 0 15px 40px rgba(0,0,0,.3);
        }

        .floating-card.top {
            top: 28px;
            right: -12px;
        }

        .floating-card.bottom {
            left: -22px;
            bottom: 42px;
        }

        .floating-card small {
            display: block;
            color: var(--muted);
            font-size: 9px;
        }

        .floating-card strong {
            color: var(--primary);
            font-family: var(--font-heading);
            font-size: 15px;
            display: block;
            margin-top: 4px;
        }

        /* =========================================
           INTRO STRIP
        ========================================== */

        .intro-strip {
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            background: #0d120f;
            padding: 27px 0;
        }

        .intro-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            flex-wrap: wrap;
        }

        .intro-content p {
            color: var(--muted);
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .intro-items {
            display: flex;
            gap: 35px;
            flex-wrap: wrap;
        }

        .intro-items span {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #c8d1ca;
            font-weight: 600;
        }

        .intro-items span::before {
            content: "✦";
            color: var(--primary);
        }

        /* =========================================
           SERVICES
        ========================================== */

        .services {
            background: var(--background);
        }

        .services-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 35px;
            margin-bottom: 55px;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 17px;
        }

        .service-card {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 33px 28px;
            border-radius: 12px;
            min-height: 340px;
            position: relative;
            overflow: hidden;
            transition: .35s ease;
        }

        .service-card:hover {
            transform: translateY(-8px);
            border-color: rgba(183,245,106,.4);
            background: #141e17;
        }

        .service-number {
            position: absolute;
            right: 24px;
            top: 22px;
            color: rgba(255,255,255,.12);
            font-family: var(--font-heading);
            font-size: 35px;
            font-weight: 700;
        }

        .service-icon {
            width: 53px;
            height: 53px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(183,245,106,.25);
            background: rgba(183,245,106,.08);
            border-radius: 11px;
            margin-bottom: 28px;
            color: var(--primary);
        }

        .service-icon svg {
            width: 25px;
            height: 25px;
        }

        .service-card h3 {
            font-family: var(--font-heading);
            font-size: 21px;
            margin-bottom: 13px;
        }

        .service-card p {
            font-size: 13px;
            line-height: 1.9;
            color: var(--muted);
            margin-bottom: 24px;
        }

        .text-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 700;
        }

        .text-link:hover svg {
            transform: translateX(5px);
        }

        /* =========================================
           ABOUT
        ========================================== */

        .about {
            background: #0d130f;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .about-grid {
            display: grid;
            grid-template-columns: .95fr 1.05fr;
            align-items: center;
            gap: 90px;
        }

        .about-visual {
            position: relative;
            min-height: 430px;
            background:
                radial-gradient(circle at 50% 40%, rgba(183,245,106,.18), transparent 55%),
                linear-gradient(135deg, #18251b, #0b100d);
            border: 1px solid var(--border);
            border-radius: 15px;
            overflow: hidden;
            display: grid;
            place-items: center;
        }

        .about-visual::before,
        .about-visual::after {
            content: "";
            position: absolute;
            border: 1px solid rgba(183,245,106,.15);
            border-radius: 50%;
        }

        .about-visual::before {
            width: 310px;
            height: 310px;
        }

        .about-visual::after {
            width: 230px;
            height: 230px;
        }

        .about-symbol {
            position: relative;
            z-index: 2;
            font-family: var(--font-heading);
            font-size: 100px;
            color: var(--primary);
            font-weight: 700;
            letter-spacing: -12px;
            text-shadow: 0 0 65px rgba(183,245,106,.25);
        }

        .about-caption {
            position: absolute;
            bottom: 25px;
            left: 25px;
            right: 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 3;
            border-top: 1px solid var(--border);
            padding-top: 15px;
            color: var(--muted);
            font-size: 11px;
        }

        .about-caption span:last-child {
            color: var(--primary);
        }

        .about-content .section-heading {
            font-size: clamp(34px, 4vw, 47px);
        }

        .about-content > p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.9;
            margin-top: 20px;
        }

        .about-points {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 32px 0;
        }

        .about-point {
            display: flex;
            gap: 11px;
            align-items: flex-start;
        }

        .check {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(183,245,106,.12);
            color: var(--primary);
            font-size: 12px;
        }

        .about-point strong {
            display: block;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .about-point small {
            display: block;
            font-size: 11px;
            color: var(--muted);
            line-height: 1.6;
        }

        /* =========================================
           WORK / PORTFOLIO
        ========================================== */

        .work-header {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 30px;
            margin-bottom: 45px;
        }

        .work-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px;
        }

        .work-card {
            border: 1px solid var(--border);
            border-radius: 13px;
            overflow: hidden;
            background: var(--surface);
            transition: .35s ease;
        }

        .work-card:hover {
            transform: translateY(-6px);
            border-color: rgba(183,245,106,.35);
        }

        .work-image {
            height: 290px;
            padding: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .work-image-one {
            background: linear-gradient(135deg, #17251b, #263c2c);
        }

        .work-image-two {
            background: linear-gradient(135deg, #18202a, #273849);
        }

        .mockup-window {
            width: 90%;
            height: 205px;
            background: #f2f4f0;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,.3);
            transform: rotate(-2deg);
            transition: .4s ease;
        }

        .work-card:hover .mockup-window {
            transform: rotate(0deg) scale(1.03);
        }

        .mockup-bar {
            height: 19px;
            background: #e2e8df;
            display: flex;
            align-items: center;
            padding: 0 10px;
            gap: 4px;
        }

        .mockup-bar i {
            width: 5px;
            height: 5px;
            background: #9ba99b;
            border-radius: 50%;
        }

        .mockup-content {
            padding: 20px;
            color: #142016;
        }

        .mockup-brand {
            font-size: 8px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 22px;
            color: #27442b;
        }

        .mockup-content h4 {
            font-family: var(--font-heading);
            font-size: 22px;
            line-height: 1.1;
            max-width: 250px;
            margin-bottom: 8px;
        }

        .mockup-content p {
            font-size: 7px;
            color: #657167;
        }

        .mockup-button {
            display: inline-block;
            background: #b7f56a;
            padding: 6px 11px;
            font-size: 7px;
            margin-top: 12px;
            border-radius: 2px;
            color: #11200e;
            font-weight: 700;
        }

        .work-info {
            padding: 23px 25px 26px;
        }

        .work-type {
            font-size: 10px;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
        }

        .work-info h3 {
            font-family: var(--font-heading);
            font-size: 21px;
            margin: 9px 0;
        }

        .work-info p {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
        }

        .portfolio-note {
            color: var(--muted);
            font-size: 11px;
            margin-top: 22px;
        }

        /* =========================================
           PROCESS
        ========================================== */

        .process {
            background: #0d130f;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .process-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .process-header .section-heading,
        .process-header .section-description {
            margin-left: auto;
            margin-right: auto;
        }

        .process-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 17px;
            position: relative;
        }

        .process-card {
            padding: 27px 22px;
            border: 1px solid var(--border);
            background: #111a14;
            border-radius: 10px;
            position: relative;
            transition: .3s ease;
        }

        .process-card:hover {
            border-color: rgba(183,245,106,.4);
            transform: translateY(-5px);
        }

        .process-card .step {
            color: var(--primary);
            font-family: var(--font-heading);
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .process-card h3 {
            font-family: var(--font-heading);
            font-size: 17px;
            margin-bottom: 11px;
        }

        .process-card p {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.8;
        }

        /* =========================================
           CTA BANNER
        ========================================== */

        .cta-section {
            padding: 95px 0;
        }

        .cta-box {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(circle at 90% 20%, rgba(183,245,106,.18), transparent 35%),
                linear-gradient(115deg, #17251a, #111a14);
            border: 1px solid rgba(183,245,106,.2);
            border-radius: 16px;
            padding: 65px 60px;
