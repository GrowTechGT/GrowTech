            }

            .about-grid {
                grid-template-columns: 1fr;
            }

            .about-visual {
                min-height: 350px;
            }

            .work-grid {
                grid-template-columns: 1fr;
            }

            .process-grid {
                grid-template-columns: 1fr 1fr;
            }

            .cta-box {
                padding: 40px 25px;
